// Petersen Memories – Datenbankmodell
// Doku: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Fuer Produktion kann hier "postgresql" oder "mysql" stehen.
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Ein hochgeladenes Foto oder Video eines Gastes.
model Media {
  id           String   @id @default(cuid())
  type         String // "image" oder "video"
  filename     String   @unique // eindeutiger Dateiname auf der Platte
  originalName String // Originalname der Datei (fuer den Download)
  mimeType     String
  size         Int // Groesse in Bytes
  guestName    String? // optionaler Name des Gastes
  message      String? // optionale Nachricht zum Upload
  approved     Boolean  @default(true) // vom Admin freigegeben / sichtbar
  createdAt    DateTime @default(now())

  likes    Like[]
  comments Comment[]

  @@index([createdAt])
  @@index([approved])
}

/// Ein Herz/Like eines anonymen Besuchers fuer ein Medium.
model Like {
  id        String   @id @default(cuid())
  mediaId   String
  media     Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  visitorId String // anonyme Besucher-ID aus dem Cookie
  createdAt DateTime @default(now())

  @@unique([mediaId, visitorId])
}

/// Ein Kommentar zu einem Medium.
model Comment {
  id        String   @id @default(cuid())
  mediaId   String
  media     Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  author    String? // optionaler Name
  body      String
  createdAt DateTime @default(now())

  @@index([mediaId])
}

/// Ein anpassbares Polaroid-Kaertchen (Bild + zwei Textzeilen).
/// Ueber das Feld `section` wird gesteuert, wo auf der Seite das
/// Kaertchen erscheint (z.B. "film" oder "kapitel-1").
model PolaroidCard {
  id        String   @id @default(cuid())
  section   String // Bereich der Webseite, zu dem das Kaertchen gehoert
  sortOrder Int      @default(0)
  caption   String // geschwungene Hauptzeile (Titel)
  note      String? // Grossbuchstaben-Unterzeile (Untertitel)
  tone      String? // Fallback-Farbverlauf, solange kein Bild vorhanden ist
  filename  String?  @unique // Bilddatei im Upload-Ordner
  mimeType  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([section, sortOrder])
}

/// Eine Audio- oder Video-Botschaft von Gaesten (Sprachmemo / Grußvideo).
model Greeting {
  id           String    @id @default(cuid())
  kind         String // "audio" oder "video"
  filename     String    @unique
  originalName String
  mimeType     String
  size         Int
  guestName    String?
  approved     Boolean   @default(true) // vom Admin freigegeben
  surprise     Boolean   @default(false) // Ueberraschungsvideo
  revealAt     DateTime? // ab wann ein Ueberraschungsvideo sichtbar ist
  createdAt    DateTime  @default(now())

  @@index([createdAt])
  @@index([kind])
}

/// Ein Brief in der Zeitkapsel – gesperrt bis zum ersten Hochzeitstag.
model TimeCapsuleLetter {
  id        String   @id @default(cuid())
  author    String // wer den Brief geschrieben hat
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}

/// Eine Einladung, die einem Teammitglied Admin-Zugriff gewaehrt.
model TeamInvite {
  id         String    @id @default(cuid())
  token      String    @unique // geheimer Teil des Einladungslinks
  label      String? // Name/Notiz, fuer wen die Einladung ist
  revoked    Boolean   @default(false)
  useCount   Int       @default(0)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([createdAt])
}
